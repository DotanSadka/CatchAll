    {
      "parameters": {
        "promptType": "define",
        "text": "=**From:**{{ $json.From }}\n**To:**{{ $json.To }}\n**Email Subject:** {{ $json.Subject }}\n**Email Body:** {{ $json.snippet }}",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an intelligent email triage system for a catch-all inbox. Your primary task is to determine if an email is genuinely 'Important' and needs human review, or if it is 'Unimportant' and can be archived automatically. If you are truly uncertain, categorize it as 'Unsure'. Provide a very brief, one-sentence justification. Respond only with a JSON object.\n\n**Important Email Criteria (Needs Human Review):**\n- Invoices or receipts\n- Legal or finance documents\n- Unsubscribe or account deletion requests\n- Emails from a vendor looking to get in touch with our sales or customer success team.\n- A registered PeerSpot user looking for help or support.\n- Any email that an employee or team would genuinely need to receive in their inbox and act upon.\n\n**Unimportant Email Criteria (Can be Archived):**\n- Spam (e.g., unsolicited advertisements, phishing attempts)\n- Newsletters or promotional emails\n- Notifications from social media platforms (LinkedIn, Glassdoor, Twitter, Facebook etc.)\n- General marketing emails\n- Automated template emails from peerspot.com\n- Not in English"
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 2,
      "position": [
        208,
        480
      ],
      "id": "7516ccc0-f43c-46fd-bd86-0e995765b99f",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"category\": {\n      \"type\": \"string\",\n      \"enum\": [\"Important\", \"Unimportant\", \"Unsure\"]\n    },\n    \"justification\": {\n      \"type\": \"string\"\n    }\n  },\n  \"required\": [\"category\", \"justification\"]\n}"
